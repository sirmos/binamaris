# Binance Agentic sub-account REST credentials.
# Generate these on the sub-account itself, not your main account.
BINANCE_AGENTIC_API_KEY=
BINANCE_AGENTIC_API_SECRET=
BINANCE_API_BASE_URL=https://api.binance.com

# Free key from aisstream.io for real vessel position and voyage data.
AISSTREAM_API_KEY=

# MMSI of the real vessel you are tracking for the demo.
VESSEL_MMSI=

NODE_ENV=development
